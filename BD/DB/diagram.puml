@startuml DB Diagram

!define table(x) class x << (T,#FFAAAA) >>

hide empty members
skinparam classAttributeIconSize 0

' Keep definitions for reference, but simplify table content
'!define primary_key(x) <b>x</b>
'!define foreign_key(x) <i>x</i>
'!define unique(x) <u:blue>x</u>
'!define not_null(x) <color:red>*</color> x

package "Authentication & Authorization" {
    table(Users) {
        id
        username
        passwordHash
        email
        fullName
        createdAt
        updatedAt
    }

    table(Roles) {
        id
        name
        description
        createdAt
        updatedAt
    }

    table(Permissions) {
        id
        name
        description
        createdAt
        updatedAt
    }

    table(UserRoles) {
        userId
        roleId
    }

    table(RolePermissions) {
        roleId
        permissionId
    }
}

package "Human Resource Management (HRM)" {
    table(Employees) {
        id
        userId
        employeeCode
        firstName
        lastName
        birthDate
        hireDate
        companyEmail
        internalAccount
        address
        phoneNumber
        emergencyContact
        position
        team
        reportingLeaderId
        currentStatus
        statusUpdatedAt
        profilePictureUrl
        createdAt
        updatedAt
        createdBy
        updatedBy
        deletedAt
    }

    table(SkillCategories) {
        id
        name
        description
        createdAt
        updatedAt
    }

    table(Skills) {
        id
        categoryId
        name
        description
        createdAt
        updatedAt
    }
    note right of Skills
        UNIQUE constraint on (categoryId, name)
    end note

    table(EmployeeSkills) {
        id
        employeeId
        skillId
        yearsExperience
        selfAssessmentLevel
        leaderAssessmentLevel
        createdAt
        updatedAt
    }
    note right of EmployeeSkills
        UNIQUE constraint on (employeeId, skillId)
    end note

    table(ProjectHistory) {
        id
        employeeId
        projectName
        clientName
        role
        startDate
        endDate
        description
        createdAt
        updatedAt
    }

    table(EmployeeStatusLog) {
        id
        employeeId
        status
        projectName
        allocationPercentage
        expectedEndDate
        logTimestamp
        createdAt
        updatedAt
    }
}

package "Margin & Performance" {
    table(EmployeeCosts) {
        id
        employeeId
        year
        month
        costAmount
        currency
        description
        createdAt
        updatedAt
    }
    note right of EmployeeCosts
        UNIQUE constraint on (employeeId, year, month)
    end note

    table(EmployeeRevenues) {
        id
        employeeId
        contractId
        year
        month
        billingRate
        allocationPercentage
        calculatedRevenue
        currency
        createdAt
        updatedAt
    }
    note right of EmployeeRevenues
        UNIQUE constraint on (employeeId, contractId, year, month)
    end note
}

package "Opportunity Management" {
    table(Opportunities) {
        id
        hubspotId
        name
        clientName
        estimatedValue
        currency
        dealStage
        source
        assignedSalesId
        lastInteractionDate
        followUpStatus
        onsitePriority
        hubspotCreatedAt
        hubspotLastUpdatedAt
        syncStatus
        lastSyncAt
        createdAt
        updatedAt
    }

    table(OpportunityAssignments) {
        id
        opportunityId
        leaderId
        assignedAt
        createdAt
        updatedAt
    }
    note right of OpportunityAssignments
        UNIQUE constraint on (opportunityId, leaderId)
    end note

    table(OpportunityNotes) {
        id
        opportunityId
        authorId
        noteContent
        createdAt
        updatedAt
    }
}

package "Contract & Revenue Management" {
     table(Contracts) {
        id
        contractCode
        name
        clientName
        opportunityId
        signDate
        effectiveDate
        expiryDate
        totalValue
        currency
        contractType
        assignedSalesId
        status
        description
        createdAt
        updatedAt
        createdBy
        updatedBy
        deletedAt
    }

    table(ContractPaymentTerms) {
        id
        contractId
        description
        expectedPaymentDate
        expectedAmount
        currency
        paymentStatus
        actualPaymentDate
        actualAmountPaid
        notes
        createdAt
        updatedAt
        createdBy
        updatedBy
    }

     table(ContractEmployees) {
        id
        contractId
        employeeId
        role
        allocationPercentage
        startDate
        endDate
        createdAt
        updatedAt
    }
    note right of ContractEmployees
        UNIQUE constraint on (contractId, employeeId)
    end note

     table(ContractFiles) {
        id
        contractId
        fileName
        filePath
        fileType
        fileSize
        uploadedById
        uploadedAt
        createdAt
        updatedAt
    }

    table(SalesKpis) {
        id
        salesUserId
        year
        quarter
        month
        targetRevenue
        currency
        createdAt
        updatedAt
        createdBy
        updatedBy
    }
    note right of SalesKpis
        UNIQUE constraint on (salesUserId, year, quarter, month)
    end note
}

package "System & Utilities" {
    table(SystemConfigs) {
        id
        configKey
        configValue
        description
        createdAt
        updatedAt
    }

    table(Notifications) {
        id
        userId
        message
        isRead
        relatedEntityType
        relatedEntityId
        createdAt
        updatedAt
    }
}


' Relationships
Users "1" -- "0..*" UserRoles : has
Roles "1" -- "0..*" UserRoles : has
Roles "1" -- "0..*" RolePermissions : has
Permissions "1" -- "0..*" RolePermissions : has

Users "1" -- "0..1" Employees : manages account for >
Users "1" -- "0..*" Employees : created by <
Users "1" -- "0..*" Employees : updated by <
Users "1" -- "0..*" Employees : leads <

Employees "1" -- "0..*" EmployeeSkills : has >
Skills "1" -- "0..*" EmployeeSkills : used by <
SkillCategories "1" -- "0..*" Skills : contains >

Employees "1" -- "0..*" ProjectHistory : has history >
Employees "1" -- "0..*" EmployeeStatusLog : logs status >
Employees "1" -- "0..*" EmployeeCosts : incurs >
Employees "1" -- "0..*" EmployeeRevenues : generates >
Contracts "1" -- "0..*" EmployeeRevenues : revenue from <

Users "1" -- "0..*" Opportunities : owns >
Opportunities "1" -- "0..*" OpportunityAssignments : assigns to >
Users "1" -- "0..*" OpportunityAssignments : assigned <
Opportunities "1" -- "0..*" OpportunityNotes : has >
Users "1" -- "0..*" OpportunityNotes : authored <

Users "1" -- "0..*" Contracts : manages >
Opportunities "0..1" -- "0..*" Contracts : leads to >
Contracts "1" -- "0..*" ContractPaymentTerms : has >
Contracts "1" -- "0..*" ContractEmployees : involves >
Employees "1" -- "0..*" ContractEmployees : involved in <
Contracts "1" -- "0..*" ContractFiles : has >
Users "1" -- "0..*" ContractFiles : uploaded <

Users "1" -- "0..*" SalesKpis : has KPI for <
Users "1" -- "0..*" SalesKpis : created by <
Users "1" -- "0..*" SalesKpis : updated by <

Users "1" -- "0..*" ContractPaymentTerms : created by <
Users "1" -- "0..*" ContractPaymentTerms : updated by <

Users "1" -- "0..*" Notifications : receives >

@enduml 