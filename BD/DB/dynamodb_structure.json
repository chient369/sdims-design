{
    "dynamo_version": "1.0",
    "notes": [
        "Mô hình dữ liệu DynamoDB dựa trên access pattern",
        "Sử dụng mô hình single-table với khóa phân vùng (PK) và khóa sắp xếp (SK)",
        "GSI (Global Secondary Index) được sử dụng cho truy vấn đa chiều",
        "Data được thiết kế theo cách denormalize để tối ưu hiệu suất truy vấn",
        "Thuộc tính được kế thừa từ cấu trúc DB quan hệ gốc",
        "Kiểu dữ liệu được chỉ định cho mỗi thuộc tính để đảm bảo tính nhất quán"
    ],
    "table": {
        "name": "SDIMS_Main",
        "primary_key": {
            "partition_key": "PK",
            "sort_key": "SK"
        },
        "indexes": [
            {
                "name": "GSI1",
                "type": "global",
                "partition_key": "GSI1PK",
                "sort_key": "GSI1SK"
            },
            {
                "name": "GSI2",
                "type": "global",
                "partition_key": "GSI2PK",
                "sort_key": "GSI2SK"
            },
            {
                "name": "GSI3",
                "type": "global",
                "partition_key": "GSI3PK",
                "sort_key": "GSI3SK"
            }
        ],
        "entity_types": {
            "USER": {
                "description": "Thông tin người dùng",
                "key_pattern": {
                    "PK": "USER#<id>",
                    "SK": "METADATA#<id>"
                },
                "indexes": {
                    "GSI1": {
                        "GSI1PK": "USER",
                        "GSI1SK": "<username>"
                    },
                    "GSI2": {
                        "GSI2PK": "USER",
                        "GSI2SK": "<email>"
                    }
                },
                "attributes": [
                    {"name": "id", "type": "String"},
                    {"name": "username", "type": "String"},
                    {"name": "password_hash", "type": "String"},
                    {"name": "email", "type": "String"},
                    {"name": "full_name", "type": "String"},
                    {"name": "created_at", "type": "String (ISO8601 DateTime)"},
                    {"name": "updated_at", "type": "String (ISO8601 DateTime)"}
                ]
            },
            "ROLE": {
                "description": "Vai trò người dùng với các quyền được gán",
                "key_pattern": {
                    "PK": "ROLE#<id>",
                    "SK": "METADATA#<id>"
                },
                "indexes": {
                    "GSI1": {
                        "GSI1PK": "ROLE",
                        "GSI1SK": "<name>"
                    },
                    "GSI3": {
                        "GSI3PK": "PERMISSION#<permission_id>",
                        "GSI3SK": "ROLE"
                    }
                },
                "attributes": [
                    {"name": "id", "type": "String"},
                    {"name": "name", "type": "String"},
                    {"name": "description", "type": "String"},
                    {"name": "permissions", "type": "List<String>", "description": "Danh sách các permission_id được gán cho vai trò này"},
                    {"name": "created_at", "type": "String (ISO8601 DateTime)"},
                    {"name": "updated_at", "type": "String (ISO8601 DateTime)"}
                ]
            },
            "USER_ROLE": {
                "description": "Liên kết người dùng với vai trò",
                "key_pattern": {
                    "PK": "USER#<user_id>",
                    "SK": "ROLE#<role_id>"
                },
                "indexes": {
                    "GSI1": {
                        "GSI1PK": "ROLE#<role_id>",
                        "GSI1SK": "USER#<user_id>"
                    }
                },
                "attributes": [
                    {"name": "user_id", "type": "String"},
                    {"name": "role_id", "type": "String"}
                ]
            },
            "PERMISSION": {
                "description": "Quyền trong hệ thống",
                "key_pattern": {
                    "PK": "PERMISSION#<id>",
                    "SK": "METADATA#<id>"
                },
                "indexes": {
                    "GSI1": {
                        "GSI1PK": "PERMISSION",
                        "GSI1SK": "<name>"
                    }
                },
                "attributes": [
                    {"name": "id", "type": "String"},
                    {"name": "name", "type": "String"},
                    {"name": "description", "type": "String"},
                    {"name": "created_at", "type": "String (ISO8601 DateTime)"},
                    {"name": "updated_at", "type": "String (ISO8601 DateTime)"}
                ]
            },
            "EMPLOYEE": {
                "description": "Thông tin nhân viên",
                "key_pattern": {
                    "PK": "EMPLOYEE#<id>",
                    "SK": "METADATA#<id>"
                },
                "indexes": {
                    "GSI1": {
                        "GSI1PK": "EMPLOYEE",
