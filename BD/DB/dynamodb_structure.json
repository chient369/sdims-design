                    },
                    "GSI2": {
                        "GSI2PK": "EMPLOYEE_STATUS#<current_status>",
                        "GSI2SK": "<last_name>#<first_name>"
                    },
                    "GSI3": {
                        "GSI3PK": "EMPLOYEE_TEAM#<team>",
                        "GSI3SK": "<last_name>#<first_name>"
                    }
                },
                "attributes": [
                    {"name": "id", "type": "String"},
                    {"name": "user_id", "type": "String"},
                    {"name": "employee_code", "type": "String"},
                    {"name": "first_name", "type": "String"},
                    {"name": "last_name", "type": "String"},
                    {"name": "birth_date", "type": "String (ISO8601 Date)"},
                    {"name": "hire_date", "type": "String (ISO8601 Date)"},
                    {"name": "company_email", "type": "String"},
                    {"name": "internal_account", "type": "String"},
                    {"name": "address", "type": "String"},
                    {"name": "phone_number", "type": "String"},
                    {"name": "emergency_contact", "type": "String"},
                    {"name": "position", "type": "String"},
                    {"name": "team", "type": "String"},
                    {"name": "reporting_leader_id", "type": "String"},
                    {"name": "current_status", "type": "String (Enum: Allocated, Available, EndingSoon, OnLeave, Resigned)"},
                    {"name": "status_updated_at", "type": "String (ISO8601 DateTime)"},
                    {"name": "profile_picture_url", "type": "String"},
                    {"name": "created_at", "type": "String (ISO8601 DateTime)"},
                    {"name": "updated_at", "type": "String (ISO8601 DateTime)"},
                    {"name": "created_by", "type": "String"},
                    {"name": "updated_by", "type": "String"},
                    {"name": "deleted_at", "type": "String (ISO8601 DateTime)"}
                ]
            },
            "EMPLOYEE_SKILL": {
                "description": "Kỹ năng của nhân viên",
                "key_pattern": {
                    "PK": "EMPLOYEE#<employee_id>",
                    "SK": "SKILL#<skill_id>"
                },
                "indexes": {
                    "GSI1": {
                        "GSI1PK": "SKILL#<skill_id>",
                        "GSI1SK": "EMPLOYEE#<employee_id>"
                    },
                    "GSI2": {
                        "GSI2PK": "SKILL#<skill_id>",
                        "GSI2SK": "<years_experience>",
                        "include": ["employee_id", "self_assessment_level", "leader_assessment_level"]
                    }
                },
                "attributes": [
                    {"name": "id", "type": "String"},
                    {"name": "employee_id", "type": "String"},
                    {"name": "skill_id", "type": "String"},
                    {"name": "years_experience", "type": "Number"},
                    {"name": "self_assessment_level", "type": "String (Enum: Basic, Intermediate, Advanced)"},
                    {"name": "leader_assessment_level", "type": "String (Enum: Basic, Intermediate, Advanced)"},
                    {"name": "created_at", "type": "String (ISO8601 DateTime)"},
                    {"name": "updated_at", "type": "String (ISO8601 DateTime)"}
                ]
            },
            "SKILL_CATEGORY": {
                "description": "Danh mục kỹ năng",
                "key_pattern": {
                    "PK": "SKILL_CATEGORY#<id>",
                    "SK": "METADATA#<id>"
