@startuml Human Resource Management Module

!define table(x) class x << (T,#FFAAAA) >>

hide empty members
skinparam classAttributeIconSize 0

' Referenced Table from Authentication
table(Users) {
    id
    username
}

package "Human Resource Management (HRM)" {
    table(Employees) {
        id
        userId
        employeeCode
        firstName
        lastName
        birthDate
        hireDate
        companyEmail
        internalAccount
        address
        phoneNumber
        emergencyContact
        position
        team
        reportingLeaderId
        currentStatus
        statusUpdatedAt
        profilePictureUrl
        createdAt
        updatedAt
        createdBy
        updatedBy
        deletedAt
    }

    table(SkillCategories) {
        id
        name
        description
        createdAt
        updatedAt
    }

    table(Skills) {
        id
        categoryId
        name
        description
        createdAt
        updatedAt
    }
    note right of Skills
        UNIQUE constraint on (categoryId, name)
    end note

    table(EmployeeSkills) {
        id
        employeeId
        skillId
        yearsExperience
        selfAssessmentLevel
        leaderAssessmentLevel
        createdAt
        updatedAt
    }
    note right of EmployeeSkills
        UNIQUE constraint on (employeeId, skillId)
    end note

    table(ProjectHistory) {
        id
        employeeId
        projectName
        clientName
        role
        startDate
        endDate
        description
        createdAt
        updatedAt
    }

    table(EmployeeStatusLog) {
        id
        employeeId
        status
        projectName
        allocationPercentage
        expectedEndDate
        logTimestamp
        createdAt
        updatedAt
    }
}

package "Margin & Performance" {
    ' Included as it relates to Employee Costs
    table(EmployeeCosts) {
        id
        employeeId
        year
        month
        costAmount
        currency
        description
        createdAt
        updatedAt
    }
    note right of EmployeeCosts
        UNIQUE constraint on (employeeId, year, month)
    end note
}


' Relationships

' Employee links to User
Users "1" -- "0..1" Employees : manages account for >
Users "1" -- "0..*" Employees : created by <
Users "1" -- "0..*" Employees : updated by <
Users "1" -- "0..*" Employees : leads <

' Skill Relationships
Employees "1" -- "0..*" EmployeeSkills : has >
Skills "1" -- "0..*" EmployeeSkills : used by <
SkillCategories "1" -- "0..*" Skills : contains >

' History and Status
Employees "1" -- "0..*" ProjectHistory : has history >
Employees "1" -- "0..*" EmployeeStatusLog : logs status >

' Cost Relationship
Employees "1" -- "0..*" EmployeeCosts : incurs >


@enduml 