@startuml Authentication Module

!define table(x) class x << (T,#FFAAAA) >>

hide empty members
skinparam classAttributeIconSize 0

package "Authentication & Authorization" {
    table(Users) {
        id
        username
        passwordHash
        email
        fullName
        createdAt
        updatedAt
    }

    table(Roles) {
        id
        name
        description
        createdAt
        updatedAt
    }

    table(Permissions) {
        id
        name
        description
        createdAt
        updatedAt
    }

    table(UserRoles) {
        userId
        roleId
    }

    table(RolePermissions) {
        roleId
        permissionId
    }
}

' Relationships
Users "1" -- "0..*" UserRoles : has >
Roles "1" -- "0..*" UserRoles : assigned to <

Roles "1" -- "0..*" RolePermissions : has >
Permissions "1" -- "0..*" RolePermissions : granted to <

@enduml 